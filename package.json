{
  "name": "dnr-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:fixtures": "vitest run --project fixtures",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "24.19.4",
    "fast-check": "4.11.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}