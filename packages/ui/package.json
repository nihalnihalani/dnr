{
  "name": "@dnr/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One React app (graveyard board, play, trial explorer) with local-API and localStorage adapters",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./engine": "./src/engine/index.ts",
    "./engine/pack": "./src/engine/pack.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.13.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.1",
    "@dnr/core": "workspace:*",
    "@dnr/schemas": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-tree-sitter": "0.27.2",
    "@dnr/hook": "workspace:*"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project unit packages/ui"
  },
  "devDependencies": {
    "@dnr/grammar": "workspace:*",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.2.3"
